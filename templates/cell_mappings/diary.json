{
  "$schema": "https://example.com/diary-cell-mapping.schema.json",
  "template_file": "diary_template.xlsx",
  "source_sheet": "【テンプレート】",
  "output_sheet_naming": "{m}月{d}日",
  "description": "業務日報。1日1シート、14名分を1ページにまとめる。10列構成：No/名前/出欠/昼食/行/帰/様子(work)/コメント(work)/様子(life)/コメント(life)。様子はAI要約、コメントは自由コメント。",
  "static": {
    "title_cell": "A1",
    "title_text": "サービス提供記録　兼　日誌",
    "legend_cell": "A3",
    "service_type_cell": "E2"
  },
  "header": {
    "date_label_cell": "A2",
    "weekday_cell": "C2",
    "date_format": "{m}月{d}日"
  },
  "table_columns_header_row": 4,
  "table_subheader_row": 5,
  "client_rows": {
    "start": 6,
    "end": 19,
    "max_clients": 14
  },
  "per_client_columns": {
    "row_no": "A",
    "client_name": "B",
    "attendance": "C",
    "lunch": "D",
    "transport_go": "E",
    "transport_return": "F",
    "work_status": "G",
    "work_comment": "H",
    "life_status": "I",
    "life_comment": "J"
  },
  "section_cells": {
    "work_morning_content": "C20",
    "work_afternoon_content": "C21",
    "remarks": "B22"
  },
  "signature_cells": {
    "staff_in_charge_value": "A23",
    "service_manager_value": "E23",
    "confirm_date_value": "H23"
  },
  "evaluation_labels": {
    "work": [
      { "key": "active_engagement", "label": "積極的に取り組んでおられていた" },
      { "key": "stable_engagement", "label": "安定して取り組まれていた" },
      { "key": "not_focused", "label": "作業に集中しておられなかった" },
      { "key": "no_motivation", "label": "作業意欲を感じなかった" }
    ],
    "life": [
      { "key": "stable_passing", "label": "安定してすごされていた" },
      { "key": "calm_passing", "label": "落ち着いてすごされていた" },
      { "key": "emotionally_unstable", "label": "情緒的に不安定なご様子です" },
      { "key": "irritated", "label": "いらいらとされていた" }
    ]
  }
}
